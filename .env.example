# Copy to .env for running the API/worker outside Docker. docker-compose.yml sets these itself.
DATABASE_URL=postgresql+psycopg://transcriber:transcriber@localhost:5432/transcriber
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50
DEFAULT_MODEL=small
JOB_TIMEOUT_SECONDS=3600
JOB_MAX_RETRIES=2
DELETE_AUDIO_AFTER_PROCESSING=true
