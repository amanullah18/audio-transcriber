# Copy to .env and change API_KEYS. docker compose reads API_KEYS and the tuning values from here;
# the connection URLs below are only used when running the API/worker outside Docker.

# Comma-separated; each key only sees its own jobs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me

DATABASE_URL=postgresql+psycopg://transcriber:transcriber@localhost:5432/transcriber
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50
DEFAULT_MODEL=small
JOB_TIMEOUT_SECONDS=3600
JOB_MAX_RETRIES=2
DELETE_AUDIO_AFTER_PROCESSING=true
STALE_JOB_GRACE_SECONDS=300
REAPER_INTERVAL_SECONDS=60
